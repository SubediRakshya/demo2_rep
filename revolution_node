#!/usr/bin/env python3

import time
import rclpy
from rclpy.node import Node # for node
from dynamixel_sdk import * # to run dynamixel like porthandler and packethandler 
from dynamixel_sdk import COMM_SUCCESS     #extended version of what we did in line 6
from dynamixel_sdk import PacketHandler
from dynamixel_sdk import PortHandler

from rclpy.qos import QoSProfile

# control table addresses
ADDR_OPERATING_MODE = 11
ADDR_TORQUE_ENABLE = 64
ADDR_GOAL_POSITION = 116
ADDR_PRESENT_POSITION = 132

# Protocol and default configuration for one motor
PROTOCOL_VERSION = 2.0
DXL_ID = 1
BAUDRATE = 57600
DEVICE_NAME = '/dev/ttyUSB0'

TORQUE_ENABLE = 1
TORQUE_DISABLE = 0
POSITION_MODE = 3  # position control mode

#  Position limits (0–4095 corresponds to 0–360°)
POS_CENTER = 2048
POS_LEFT = POS_CENTER - 1024
POS_RIGHT = POS_CENTER + 1024


class RotateMotorNode(Node):
    def __init__(self):
        super().__init__('rotate_motor_node')

        # Initialize SDK handlers
        self.port_handler = PortHandler(DEVICE_NAME)
        self.packet_handler = PacketHandler(PROTOCOL_VERSION)

        if not self.port_handler.openPort():
            self.get_logger().error('Failed to open port.')
            return
        if not self.port_handler.setBaudRate(BAUDRATE):
            self.get_logger().error('Failed to set baudrate.')
            return

        # Set to position control mode
        self.packet_handler.write1ByteTxRx(self.port_handler, DXL_ID, ADDR_OPERATING_MODE, POSITION_MODE)

        # Enable torque
        self.packet_handler.write1ByteTxRx(self.port_handler, DXL_ID, ADDR_TORQUE_ENABLE, TORQUE_ENABLE)
        self.get_logger().info('Motor ready in position control mode.')

        # Motion sequence
        self.positions = [POS_LEFT, POS_RIGHT, POS_CENTER]
        self.current_index = 0

        # Run motor every 3 seconds
        self.timer = self.create_timer(3.0, self.move_motor_once)
    # this is the function to move the motor
    def move_motor_once(self):
        # Move motor between preset positions left, right and center in this case
        goal_position = self.positions[self.current_index]  # these come from the already set positions that we defined already
        self.get_logger().info(f'Moving to position: {goal_position}')
        
        self.packet_handler.write4ByteTxRx(self.port_handler, DXL_ID, ADDR_GOAL_POSITION, goal_position)
        time.sleep(2.0)

        # Update to next target position
        self.current_index = (self.current_index + 1) % len(self.positions)

    def destroy_node(self):
        """Disable torque and close port on shutdown."""
        self.packet_handler.write1ByteTxRx(self.port_handler, DXL_ID, ADDR_TORQUE_ENABLE, TORQUE_DISABLE)
        self.port_handler.closePort()
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = RotateMotorNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
